run-plugin-ci.sh
build-amd.sh

# amd/build/ is deliberately NOT ignored: Moodle plugins ship their built AMD modules,
# and moodle-plugin-ci's grunt check fails if the committed build is missing or stale.
# Rebuild with: npx grunt amd --root=local/quizrenumber (from a Moodle root, Node 22).

