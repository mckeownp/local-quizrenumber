{{!
    @template local_quizrenumber/preview_table

    Preview of the renames the tool will perform, grouped by quiz.

    The same template renders the read-only results table after applying, with isresults set.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local-quizrenumber-preview"
    * data-region="preview-row"
    * data-region="strippedname" (on the cell)
    * data-region="newname" (on the inner <code>, see note below)

    Context variables required for this template:
    * quizzes - array of quizzes, each with quizid, quizname and rows
    * warnings - array of translated warning strings
    * hasrows - whether there is anything to show
    * isresults - true when showing what was done rather than what will be done
    * appliedcount - number of rows that will be, or were, renamed
    * skippedcount - number of rows left alone
    * jsconfig - JSON encoded numbering options for the live preview

    Example context (json):
    {
        "hasrows": true,
        "isresults": false,
        "appliedcount": 2,
        "skippedcount": 1,
        "warnings": [],
        "jsconfig": "{}",
        "quizzes": [
            {
                "quizid": 3,
                "quizname": "Week 1 quiz",
                "rows": [
                    {
                        "slot": 1, "currentname": "0010_alpha", "strippedname": "alpha",
                        "newname": "0010_alpha", "bankname": "Default for C1", "israndom": false,
                        "skipreason": "", "skiplabel": "", "skipped": false, "shared": false,
                        "usagecount": 1, "usagetooltip": "", "usageurl": ""
                    }
                ]
            }
        ]
    }
}}
<div class="local-quizrenumber-preview" data-region="local-quizrenumber-preview" data-config="{{jsconfig}}">

    {{#warnings}}
        <div class="alert alert-warning" role="alert">{{.}}</div>
    {{/warnings}}

    {{^hasrows}}
        <div class="alert alert-info" role="alert">{{#str}}nothingtorenumber, local_quizrenumber{{/str}}</div>
    {{/hasrows}}

    {{#hasrows}}
        <p class="local-quizrenumber-summary">
            {{#isresults}}
                {{#str}}resultssummary, local_quizrenumber, {{appliedcount}}{{/str}}
            {{/isresults}}
            {{^isresults}}
                <span data-region="local-quizrenumber-summary">
                    {{#str}}previewsummary, local_quizrenumber, {{appliedcount}}{{/str}}
                </span>
            {{/isresults}}
        </p>

        {{#quizzes}}
            {{! Already escaped by format_string() in PHP, so emit raw to avoid double-escaping
                "R&D" into "R&amp;D". Safe in element content: format_string() converts
                < and > to entities. }}
            <h4 class="mt-4">{{{quizname}}}</h4>
            <div class="table-responsive">
                <table class="table table-sm generaltable local-quizrenumber-table">
                    {{! Not parameterised with the quiz name: a comma in the name would break the str helper's argument parsing. }}
                    <caption class="sr-only">{{#str}}previewtablecaption, local_quizrenumber{{/str}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}columnslot, local_quizrenumber{{/str}}</th>
                            <th scope="col">{{#str}}columncurrentname, local_quizrenumber{{/str}}</th>
                            <th scope="col">{{#str}}columnstrippedname, local_quizrenumber{{/str}}</th>
                            <th scope="col">{{#str}}columnnewname, local_quizrenumber{{/str}}</th>
                            <th scope="col">{{#str}}columnbank, local_quizrenumber{{/str}}</th>
                            <th scope="col">{{#str}}columnnotes, local_quizrenumber{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr data-region="preview-row"
                                data-quizid="{{quizid}}"
                                data-name="{{currentname}}"
                                data-random="{{#israndom}}1{{/israndom}}{{^israndom}}0{{/israndom}}"
                                data-skip="{{skipreason}}"
                                class="{{#skipped}}text-muted table-secondary{{/skipped}}">
                                <th scope="row">{{slot}}</th>
                                <td>{{currentname}}</td>
                                <td data-region="strippedname">{{strippedname}}</td>
                                {{! The region is on the <code>, not the <td>: preview.js assigns
                                    textContent to whatever carries it, and assigning to the cell
                                    would replace the <code> child with a bare text node, silently
                                    dropping the monospace as soon as the JS first runs. }}
                                <td><code data-region="newname">{{newname}}</code></td>
                                <td>{{{bankname}}}</td>
                                <td>
                                    {{#skiplabel}}
                                        <span class="badge badge-secondary">{{skiplabel}}</span>
                                    {{/skiplabel}}
                                    {{#shared}}
                                        {{! Deliberately escaped, unlike the cells above: this lands in an
                                            attribute, and format_string() does not escape quotes, so a name
                                            containing one could otherwise break out of the title. }}
                                        {{#usageurl}}
                                            <a href="{{usageurl}}" class="badge badge-warning"
                                               title="{{usagetooltip}}">
                                                {{#str}}usedelsewhere, local_quizrenumber, {{usagecount}}{{/str}}
                                            </a>
                                        {{/usageurl}}
                                        {{^usageurl}}
                                            <span class="badge badge-warning" title="{{usagetooltip}}">
                                                {{#str}}usedelsewhere, local_quizrenumber, {{usagecount}}{{/str}}
                                            </span>
                                        {{/usageurl}}
                                    {{/shared}}
                                </td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        {{/quizzes}}
    {{/hasrows}}
</div>
